---
import { Icon } from 'astro-icon/components';
import { terminalReplayScenes } from '../data/terminal-demo';
import type { Locale } from '../types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (en: string, cn: string) => (zh ? cn : en);
const copyLabel = t('Copy command', '复制命令');
const copiedLabel = t('Copied', '已复制');
---

<section id="recorded-runs" class="terminal-demo" data-terminal-demo aria-labelledby="terminal-demo-title">
  <div class="terminal-demo__heading">
    <p class="eyebrow">{t('RECORDED CLI RUNS', '已录制的 CLI 运行')}</p>
    <h3 id="terminal-demo-title">{t('A CLI demo, with real output.', '真实输出的 CLI Demo。')}</h3>
  </div>

  <div class="terminal-demo__shell">
    <div class="terminal-demo__tabs" role="tablist" aria-label={t('Recorded run scenarios', '已录制的运行场景')}>
      {
        terminalReplayScenes.map((scene, index) => (
          <button
            class:list={['terminal-demo__tab', { 'is-active': index === 0 }]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`terminal-demo-panel-${scene.id}`}
            id={`terminal-demo-tab-${scene.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-terminal-tab={index}
          >
            <Icon name={scene.icon} size="17" aria-hidden="true" />
            <span>{scene.label}</span>
          </button>
        ))
      }
      <span class="terminal-demo__badge">
        <Icon name="tabler:circle-filled" size="10" aria-hidden="true" />
        {t('recorded replay', '录制回放')}
      </span>
    </div>

    {
      terminalReplayScenes.map((scene, index) => (
        <article
          class="terminal-demo__panel"
          id={`terminal-demo-panel-${scene.id}`}
          role="tabpanel"
          aria-labelledby={`terminal-demo-tab-${scene.id}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
          hidden={index !== 0}
          data-terminal-panel={index}
        >
          <header class="terminal-demo__toolbar">
            <span class="terminal-demo__controls" aria-hidden="true">
              <>
                <i />
                <i />
                <i />
              </>
            </span>
            <span class="terminal-demo__label">{scene.label} · qwen-plus</span>
            <button
              class="terminal-demo__copy"
              type="button"
              data-terminal-copy={scene.command}
              data-copy-label={copyLabel}
              data-copied-label={copiedLabel}
              aria-label={`${copyLabel}: ${scene.label}`}
            >
              <Icon name="tabler:copy" size="15" aria-hidden="true" />
              <span>{copyLabel}</span>
            </button>
          </header>
          <div
            class="terminal-demo__screen"
            aria-live="polite"
            aria-label={t('Recorded terminal output', '已录制终端输出')}
          >
            {scene.lines.map((line, lineIndex) =>
              line.block === 'table' ? (
                <pre
                  class:list={['terminal-demo__table', `is-${line.tone}`, { 'is-visible': index === 0 }]}
                  data-terminal-line={lineIndex}
                  set:text={line.text}
                />
              ) : (
                <p
                  class:list={['terminal-demo__line', `is-${line.tone}`, { 'is-visible': index === 0 }]}
                  data-terminal-line={lineIndex}
                  data-terminal-progress={line.progress ? JSON.stringify(line.progress) : undefined}
                >
                  {line.text}
                </p>
              )
            )}
          </div>
          <footer class="terminal-demo__footer">
            <span>{scene.summary}</span>
            <span>{scene.recordedAt}</span>
            <code>{scene.outputPath}</code>
          </footer>
        </article>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-terminal-demo]').forEach((demo) => {
    if (demo.dataset.terminalReady) return;
    demo.dataset.terminalReady = 'true';

    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[data-terminal-tab]')];
    const panels = [...demo.querySelectorAll<HTMLElement>('[data-terminal-panel]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let stopped = reducedMotion;
    let rotationTimer: number | undefined;
    let lineTimers: number[] = [];

    const clearTimers = () => {
      if (rotationTimer) window.clearTimeout(rotationTimer);
      rotationTimer = undefined;
      lineTimers.forEach((timer) => window.clearTimeout(timer));
      lineTimers = [];
    };

    const revealLines = (panel: HTMLElement, replay: boolean) => {
      const screen = panel.querySelector<HTMLElement>('.terminal-demo__screen');
      if (screen) screen.scrollTop = 0;
      const lines = [...panel.querySelectorAll<HTMLElement>('[data-terminal-line]')];
      lines.forEach((line) => line.classList.remove('is-visible'));
      let delay = replay ? 110 : 0;
      lines.forEach((line) => {
        lineTimers.push(window.setTimeout(() => line.classList.add('is-visible'), delay));

        const frames = line.dataset.terminalProgress ? JSON.parse(line.dataset.terminalProgress) : [];
        if (Array.isArray(frames) && frames.length > 0) {
          line.textContent = replay ? frames[0] : frames.at(-1);
          if (replay) {
            frames.slice(1).forEach((frame, frameIndex) => {
              lineTimers.push(window.setTimeout(() => (line.textContent = frame), delay + 500 * (frameIndex + 1)));
            });
            delay += 500 * (frames.length - 1) + 180;
          }
        }

        if (replay) delay += 125;
      });
    };

    const scheduleRotation = () => {
      if (stopped || reducedMotion) return;
      rotationTimer = window.setTimeout(() => {
        activate((activeIndex + 1) % tabs.length, true);
      }, 20000);
    };

    const activate = (index: number, replay = true) => {
      clearTimers();
      activeIndex = index;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.setAttribute('aria-hidden', String(!active));
        if (active) revealLines(panel, replay);
      });
      scheduleRotation();
    };

    const stopRotation = () => {
      stopped = true;
      if (rotationTimer) window.clearTimeout(rotationTimer);
      rotationTimer = undefined;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        stopRotation();
        activate(index);
      });
      tab.addEventListener('keydown', (event) => {
        const lastIndex = tabs.length - 1;
        let nextIndex: number | undefined;
        if (event.key === 'ArrowRight') nextIndex = index === lastIndex ? 0 : index + 1;
        if (event.key === 'ArrowLeft') nextIndex = index === 0 ? lastIndex : index - 1;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = lastIndex;
        if (nextIndex === undefined) return;
        event.preventDefault();
        stopRotation();
        activate(nextIndex);
        tabs[nextIndex].focus();
      });
    });

    demo.addEventListener('pointerdown', stopRotation, { once: true });
    demo.addEventListener('keydown', stopRotation, { once: true });
    demo.querySelectorAll<HTMLButtonElement>('[data-terminal-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        stopRotation();
        await navigator.clipboard.writeText(button.dataset.terminalCopy ?? '');
        const label = button.querySelector('span');
        if (!label) return;
        label.textContent = button.dataset.copiedLabel ?? 'Copied';
        window.setTimeout(() => {
          label.textContent = button.dataset.copyLabel ?? 'Copy command';
        }, 1400);
      });
    });

    activate(0, false);
  });
</script>

<style>
  .terminal-demo {
    margin-top: 42px;
    scroll-margin-top: 82px;
  }

  .terminal-demo__heading {
    margin-bottom: 16px;
  }

  .terminal-demo__heading h3 {
    margin: 10px 0 0;
    font-size: clamp(27px, 3vw, 40px);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .terminal-demo__shell {
    overflow: hidden;
    border: 1px solid #263946;
    background: #101d27;
    box-shadow: 9px 9px 0 color-mix(in srgb, var(--gold), transparent 25%);
    color: #e8eef2;
  }

  .terminal-demo__tabs {
    display: flex;
    gap: 0;
    align-items: stretch;
    min-height: 50px;
    padding: 7px 9px;
    border-bottom: 1px solid #263946;
    background: linear-gradient(180deg, #1c2b36, #16242e);
  }

  .terminal-demo__tab {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    border: 1px solid transparent;
    padding: 0 12px;
    background: transparent;
    color: #b8c3cb;
    cursor: pointer;
    font: 700 12px/1 var(--mono);
    text-transform: uppercase;
  }

  .terminal-demo__tab:hover,
  .terminal-demo__tab:focus-visible,
  .terminal-demo__tab.is-active {
    border-color: color-mix(in srgb, var(--gold), transparent 35%);
    background: #263946;
    color: #fff;
    outline: none;
  }

  .terminal-demo__tab.is-active svg {
    color: var(--gold);
  }

  .terminal-demo__badge {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    margin-left: auto;
    padding: 0 7px;
    color: #aeb9c2;
    font: 10px/1 var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .terminal-demo__badge svg {
    color: var(--gold);
  }

  .terminal-demo__toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 42px;
    align-items: center;
    padding: 0 13px;
    border-bottom: 1px solid #263946;
  }

  .terminal-demo__controls {
    display: flex;
    gap: 6px;
  }

  .terminal-demo__controls i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f5bd45;
  }

  .terminal-demo__controls i:nth-child(2) {
    background: #d99138;
  }

  .terminal-demo__controls i:nth-child(3) {
    background: #9c722b;
  }

  .terminal-demo__label {
    color: #aeb9c2;
    font: 11px var(--mono);
  }

  .terminal-demo__copy {
    justify-self: end;
    display: inline-flex;
    gap: 5px;
    align-items: center;
    border: 0;
    border-radius: 7px;
    padding: 6px 8px;
    background: transparent;
    color: #dbe5eb;
    cursor: pointer;
    font: 11px var(--mono);
  }

  .terminal-demo__copy:hover,
  .terminal-demo__copy:focus-visible {
    background: #2a3d4b;
    outline: none;
  }

  .terminal-demo__screen {
    display: grid;
    align-content: start;
    gap: 2px;
    max-height: 440px;
    overflow: auto;
    padding: 18px 20px 21px;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--gold), transparent 80%) 0 1px, transparent 1px) 20px 0 / 1px 100%
        no-repeat,
      linear-gradient(120deg, #0c1821, #101d27);
  }

  .terminal-demo__line,
  .terminal-demo__table {
    margin: 0;
    color: #c3cdd4;
    font: 11px/1.2 var(--mono);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    white-space: pre;
  }

  .terminal-demo__table {
    display: block;
    tab-size: 2;
  }

  .terminal-demo__line.is-visible,
  .terminal-demo__table.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .terminal-demo__line.is-command,
  .terminal-demo__table.is-command {
    color: #f7f5ef;
  }

  .terminal-demo__line.is-result,
  .terminal-demo__table.is-result {
    color: #a9d89d;
  }

  .terminal-demo__line.is-path,
  .terminal-demo__table.is-path {
    color: #f0c567;
  }

  .terminal-demo__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 15px;
    align-items: center;
    min-height: 38px;
    padding: 9px 16px;
    border-top: 1px solid #263946;
    color: #aeb9c2;
    font: 10px/1.4 var(--mono);
  }

  .terminal-demo__footer span:first-child {
    color: #e8eef2;
  }

  .terminal-demo__footer code {
    color: #f0c567;
    overflow-wrap: anywhere;
  }

  @media (max-width: 720px) {
    .terminal-demo {
      margin-top: 34px;
    }

    .terminal-demo__heading {
      margin-bottom: 14px;
    }

    .terminal-demo__tabs {
      overflow-x: auto;
      padding: 7px;
    }

    .terminal-demo__tab {
      flex: 0 0 auto;
    }

    .terminal-demo__badge {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-demo__line,
    .terminal-demo__table {
      transition: none;
    }
  }
</style>
