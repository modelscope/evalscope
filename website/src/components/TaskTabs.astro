---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../types';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const t = (en: string, cn: string) => (zh ? cn : en);
const tasks = [
  {
    icon: 'tabler:chart-bar',
    label: t('Evaluate a model', '评测模型能力'),
    title: t('Run a bounded evaluation.', '运行有边界的评测。'),
    detail: t(
      'Ask the agent to use an API model, score five samples and return the evidence path.',
      '让 Agent 使用 API 模型，评测五条样本并返回证据路径。'
    ),
    prompt: t(
      'Use EvalScope to run exactly five GSM8K samples against the configured API endpoint. Read DASHSCOPE_API_KEY from the environment, do not download a model or use a GPU, and preserve the outputs. Return the exact command, score, output path and any limitation. If configuration is missing, say so clearly.',
      '请使用 EvalScope 对已配置的 API 端点恰好运行五条 GSM8K 样本。从环境变量读取 DASHSCOPE_API_KEY，不下载模型、不使用 GPU，并保留输出。返回精确命令、分数、产物路径和任何限制；如配置缺失，请明确说明。'
    ),
  },
  {
    icon: 'tabler:bolt',
    label: t('Stress-test an API', '压测 API 服务'),
    title: t('Measure a service under load.', '测量服务在负载下的表现。'),
    detail: t(
      'Choose a small concurrency sweep and ask for latency, TTFT, RPS and throughput evidence.',
      '选择一个小范围并发扫描，要求返回延迟、TTFT、RPS 和吞吐证据。'
    ),
    prompt: t(
      'Use EvalScope to run a small closed-loop performance sweep against the configured API endpoint. Do not download a model or use a GPU. State the model, concurrency, warmup and duration, then return RPS, latency, TTFT, throughput, artifact path and any limitation. If the endpoint is unavailable, say so instead of inferring a result.',
      '请使用 EvalScope 对已配置的 API 端点运行一次小范围闭环性能扫描。不要下载模型或使用 GPU。说明模型、并发、预热和时长，然后返回 RPS、延迟、TTFT、吞吐、产物路径和任何限制。若端点不可用，请明确说明，不要推测结果。'
    ),
  },
  {
    icon: 'tabler:database-search',
    label: t('Find a benchmark', '寻找评测集'),
    title: t('Match a benchmark to the job.', '为任务匹配合适的评测集。'),
    detail: t(
      'Search available tasks and explain fit, metrics and runnable constraints before evaluating.',
      '先检索可用任务，再解释适配性、指标和可运行约束。'
    ),
    prompt: t(
      'Inspect the local benchmark catalog and generated documentation. For reasoning, coding and multimodal needs, recommend candidates with task type, metric, evaluation version, runnable constraints and why each fits. Do not download or run a model. Mark any detail you cannot verify locally.',
      '请检查本地 benchmark 目录和自动生成的文档。针对推理、代码和多模态需求，推荐候选评测集，并说明任务类型、指标、评测版本、可运行约束和适配原因。不要下载或运行模型；无法在本地验证的细节请明确标注。'
    ),
  },
  {
    icon: 'tabler:folders',
    label: t('Inspect existing results', '审查既有结果'),
    title: t('Open an evidence trail.', '打开一条证据链。'),
    detail: t(
      'Review reports, predictions, reviews and configs without rerunning the model.',
      '无需重新运行模型，即可审查报告、预测、review 与配置。'
    ),
    prompt: t(
      'Inspect existing output directories only. Do not call a model API, download a model, use a GPU or rerun evaluation. Identify available reports, predictions, reviews and configs; give the exact local command to open the dashboard or report; and name any expected artifact that is absent.',
      '只检查已有输出目录。不要调用模型 API、下载模型、使用 GPU 或重新运行评测。识别可用的报告、预测、review 和配置；给出打开本地 Dashboard 或报告的精确命令，并列出缺失的预期产物。'
    ),
  },
];
---

<div class="job-tabs" data-job-tabs>
  <div class="job-tab-list" role="tablist" aria-label={t('Choose a task', '选择任务')}>
    {
      tasks.map((task, index) => (
        <button
          class:list={['job-tab', { active: index === 0 }]}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`job-panel-${index}`}
          data-job-tab={index}
        >
          <Icon name={task.icon} size="20" />
          <span>{task.label}</span>
        </button>
      ))
    }
  </div>
  {
    tasks.map((task, index) => (
      <article
        class="job-tab-panel"
        id={`job-panel-${index}`}
        role="tabpanel"
        aria-hidden={index === 0 ? 'false' : 'true'}
        hidden={index !== 0}
        data-job-panel={index}
      >
        <div>
          <p class="eyebrow">{task.label}</p>
          <h3>{task.title}</h3>
          <p>{task.detail}</p>
        </div>
        <div class="job-tab-prompt">
          <pre>{task.prompt}</pre>
          <button
            class="button alt"
            type="button"
            data-copy-task={task.prompt}
            data-copy-label={t('Copy prompt', '复制提示词')}
            data-copied-label={t('Copied', '已复制')}
          >
            {t('Copy prompt', '复制提示词')}
          </button>
        </div>
      </article>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-job-tabs]').forEach((tabs) => {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-job-tab]')];
    const panels = [...tabs.querySelectorAll<HTMLElement>('[data-job-panel]')];

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.jobTab;
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-selected', String(active));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.jobPanel === selected;
          panel.hidden = !active;
          panel.setAttribute('aria-hidden', String(!active));
        });
      });
    });

    tabs.querySelectorAll<HTMLButtonElement>('[data-copy-task]').forEach((button) => {
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(button.dataset.copyTask ?? '');
        button.textContent = button.dataset.copiedLabel ?? 'Copied';
        window.setTimeout(() => {
          button.textContent = button.dataset.copyLabel ?? 'Copy prompt';
        }, 1400);
      });
    });
  });
</script>
