---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../types';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const t = (en: string, cn: string) => (zh ? cn : en);
const tasks = [
  {
    icon: 'tabler:chart-bar',
    label: t('Evaluate a model', '评测模型能力'),
    title: t('Run a bounded evaluation.', '运行有边界的评测。'),
    detail: t(
      'Choose the model and evaluation context with the agent, then review the saved results.',
      '与 Agent 确认模型和评测上下文，再查看已保存的结果。'
    ),
    prompt:
      'Use the EvalScope project skill to evaluate qwen-plus on five GSM8K samples. Ask me for the model or endpoint configuration you need before running it, then report the results and where the outputs were saved.',
  },
  {
    icon: 'tabler:bolt',
    label: t('Stress-test an API', '压测 API 服务'),
    title: t('Measure a service under load.', '测量服务在负载下的表现。'),
    detail: t(
      'Choose a small concurrency sweep and ask for latency, TTFT, RPS and throughput evidence.',
      '选择一个小范围并发扫描，要求返回延迟、TTFT、RPS 和吞吐证据。'
    ),
    prompt:
      'Use the EvalScope project skill to run a small performance test. Ask me for the endpoint, model, and traffic settings you need, then report the key performance results and where the outputs were saved.',
  },
  {
    icon: 'tabler:database-search',
    label: t('Find a benchmark', '寻找评测集'),
    title: t('Match a benchmark to the job.', '为任务匹配合适的评测集。'),
    detail: t(
      'Search available tasks and explain fit, metrics and runnable constraints before evaluating.',
      '先检索可用任务，再解释适配性、指标和可运行约束。'
    ),
    prompt:
      'Use the EvalScope project skill to help me choose benchmarks. Ask what capability, modality, and constraints I need to evaluate, then recommend suitable benchmarks and explain why.',
  },
  {
    icon: 'tabler:folders',
    label: t('Inspect existing results', '审查既有结果'),
    title: t('Open an evidence trail.', '打开一条证据链。'),
    detail: t(
      'Review reports, predictions, reviews and configs without rerunning the model.',
      '无需重新运行模型，即可审查报告、预测、review 与配置。'
    ),
    prompt:
      'Use the EvalScope project skill to inspect my existing evaluation outputs. Ask where the output directory is if needed, then summarize the available reports and explain how to open them.',
  },
];
---

<div class="job-tabs" data-job-tabs>
  <div class="job-tab-list" role="tablist" aria-label={t('Choose a task', '选择任务')}>
    {
      tasks.map((task, index) => (
        <button
          class:list={['job-tab', { active: index === 0 }]}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`job-panel-${index}`}
          data-job-tab={index}
        >
          <Icon name={task.icon} size="20" />
          <span>{task.label}</span>
        </button>
      ))
    }
  </div>
  {
    tasks.map((task, index) => (
      <article
        class="job-tab-panel"
        id={`job-panel-${index}`}
        role="tabpanel"
        aria-hidden={index === 0 ? 'false' : 'true'}
        hidden={index !== 0}
        data-job-panel={index}
      >
        <div>
          <p class="eyebrow">{task.label}</p>
          <h3>{task.title}</h3>
          <p>{task.detail}</p>
        </div>
        <div class="job-tab-prompt">
          <pre>{task.prompt}</pre>
          <button
            class="button alt"
            type="button"
            data-copy-task={task.prompt}
            data-copy-label={t('Copy prompt', '复制提示词')}
            data-copied-label={t('Copied', '已复制')}
          >
            {t('Copy prompt', '复制提示词')}
          </button>
        </div>
      </article>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-job-tabs]').forEach((tabs) => {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-job-tab]')];
    const panels = [...tabs.querySelectorAll<HTMLElement>('[data-job-panel]')];

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.jobTab;
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-selected', String(active));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.jobPanel === selected;
          panel.hidden = !active;
          panel.setAttribute('aria-hidden', String(!active));
        });
      });
    });

    tabs.querySelectorAll<HTMLButtonElement>('[data-copy-task]').forEach((button) => {
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(button.dataset.copyTask ?? '');
        button.textContent = button.dataset.copiedLabel ?? 'Copied';
        window.setTimeout(() => {
          button.textContent = button.dataset.copyLabel ?? 'Copy prompt';
        }, 1400);
      });
    });
  });
</script>
