---
import logo from '../assets/brand/evalscope-logo.png';
import { copy, docsUrl, localizePath } from '../data/site';
import type { Locale } from '../types';
const { locale } = Astro.props as { locale: Locale };
const text = copy[locale];
---

<footer>
  <div class="container footer-inner">
    <div>
      <a class="footer-brand" href={localizePath('/', locale)}><img src={logo.src} alt="" />EvalScope</a><p>
        {text.allRights}
      </p>
    </div>
    <div class="footer-links">
      <a href={docsUrl(locale)}>Documentation</a><a href="https://github.com/modelscope/evalscope">GitHub</a><a
        href={localizePath('/get-started', locale)}>{text.getStarted}</a
      >
    </div>
  </div>
  <div class="container legal">© {new Date().getFullYear()} ModelScope Community · Apache-2.0</div>
</footer>
<style>
  footer {
    border-top: 1px solid var(--rule);
    padding: 38px 0 22px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 28px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 850;
    letter-spacing: -0.05em;
  }
  .footer-brand img {
    width: 27px;
  }
  footer p,
  .legal {
    color: var(--muted);
    font-size: 13px;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 20px;
    font-size: 13px;
    font-weight: 700;
  }
  .legal {
    margin-top: 40px;
    font: 11px var(--mono);
  }
  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
