                  <>
                    <strong>VLM</strong>
                    <span>{t('Vision-language and multimodal tasks', '视觉语言与多模态任务')}</span>
                  </>
                </div>
                <div>
                  <>
                    <strong>AIGC</strong>
                    <span>{t('Text-to-image and image editing', '文生图与图像编辑')}</span>
                  </>
                </div>
                <div>
                  <>
                    <strong>RAG</strong>
                    <span>{t('Retrieval and generation quality', '检索与生成质量')}</span>
                  </>
                </div>
              </>
            </div>
            <h2 class="section-title" style="margin-top:64px">
              {t('From a dataset row to the report you share.', '从一条数据到可分享的报告。')}
            </h2>
            <div class="evidence-path">
              {evidence.map(([name, detail]) => (
                <div class="evidence-step">
                  <strong>{name}</strong>
                  <span>{detail}</span>
                </div>
              ))}
            </div>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <div class="section-register">
            <>
              <div>
                <h2 class="section-title tight">{t('Evaluation that survives scrutiny.', '经得起审查的评测。')}</h2>
              </div>
              <p>{t('Transparent · reproducible · extensible', '透明 · 可复现 · 可扩展')}</p>
            </>
          </div>
          <div class="card-grid">
            <>
              <article class="card">
                <>
                  <ClaimBadge status="today" locale={locale} />
                  <h3>{t('Versioned semantics', '语义版本化')}</h3>
                  <p>
                    {t(
                      'Benchmark metadata publishes evaluation versions, so prompt, mapping, data or scoring changes can be visible.',
                      'Benchmark metadata 发布评测版本，使 prompt、映射、数据或评分变化可见。'
                    )}
                  </p>
                </>
              </article>
              <article class="card">
                <>
                  <ClaimBadge status="today" locale={locale} />
