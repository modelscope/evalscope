---
import { Icon } from 'astro-icon/components';
import agentShot from '../assets/demo/agent-qwen-plus-gsm8k.png';
import evalShot from '../assets/demo/evaluation-qwen-plus-gsm8k.png';
import perfCharts from '../assets/demo/performance-qwen-plus-charts.png';
import perfShot from '../assets/demo/performance-qwen-plus-overview.png';
import researchSpiral from '../assets/illustrations/research-spiral.png';
import { localizePath } from '../data/site';
import { getBenchmarkCatalog } from '../lib/benchmarks';
import type { Locale, PageSlug } from '../types';
import BenchmarkCatalog from './BenchmarkCatalog.astro';
import ClaimBadge from './ClaimBadge.astro';
import PromptCard from './PromptCard.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';

interface Props {
  page?: PageSlug;
  locale: Locale;
}
const { page, locale } = Astro.props;
const zh = locale === 'zh';
const count = getBenchmarkCatalog().length;
const t = (en: string, cn: string) => (zh ? cn : en);
const to = (path: '/' | `/${PageSlug}`) => localizePath(path, locale);
const prompt = t(
  'Use the EvalScope project skill to configure and run a 5-sample GSM8K evaluation against my OpenAI-compatible API. Do not download a local model or use a GPU. Read the relevant skill reference, use my API key from an environment variable, report the score and artifact path, then show me how to open the local dashboard.',
  '请使用 EvalScope 项目 Skill，针对我的 OpenAI-compatible API 配置并运行 GSM8K 的 5 条样本评测。不要下载本地模型，也不要使用 GPU。先阅读相关 Skill，从环境变量读取 API key，输出分数与产物路径，并说明如何打开本地 Dashboard。'
);
const evidence = [
  ['Dataset', t('Versioned samples', '版本化样本')],
  ['Prediction', t('Model or API output', '模型或 API 输出')],
  ['Review', t('Scoring evidence', '评分证据')],
  ['Report', t('Decision artifacts', '决策产物')],
];
---

{
  !page && (
    <>
      <section class="hero">
        <div class="container hero-grid">
          <>
            <div>
              <>
                <p class="eyebrow">{t('OPEN-SOURCE EVALUATION INFRASTRUCTURE', '开源 AI 评测基础设施')}</p>
                <h1 class="display">
                  {t(
                    'From model quality to system performance — evaluate it all with EvalScope.',
                    '从模型能力到系统性能，用 EvalScope 统一评测。'
                  )}
                </h1>
                <div class="gold-line" />
                <p class="lede">
                  {t(
                    'One evidence path for LLMs, VLMs, agents, benchmarks, load tests, and the artifacts behind every decision.',
                    '一条可追溯的证据路径，覆盖 LLM、VLM、Agent、评测集、压测与每个决策背后的产物。'
                  )}
                </p>
                <div class="button-row">
                  <>
                    <a class="button" href={to('/get-started')}>
                      {t('Use with AI', '让 AI 帮你用')}
                      <Icon name="tabler:sparkles" />
                    </a>
                    <a class="button alt" href={to('/evaluation')}>
                      {t('Explore evaluation', '查看评测')}
                      <Icon name="tabler:arrow-right" />
                    </a>
                  </>
                </div>
              </>
            </div>
            <ScreenshotFrame src={evalShot} alt="Real EvalScope qwen-plus GSM8K results" />
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <>
            <p class="eyebrow">{t('ONE SYSTEM, THREE MEASUREMENT SURFACES', '一个系统，三种测量视角')}</p>
            <h2 class="section-title">{t('Make every AI release legible.', '让每一次 AI 发布都有据可查。')}</h2>
            <div class="card-grid">
              <>
                <article class="card">
                  <>
                    <Icon name="tabler:scale" size="30" />
                    <h3>{t('Evaluation', '模型评测')}</h3>
                    <p>
                      {t(
                        'LLM, VLM, AIGC and RAG tasks with sample reviews, judge contracts, versioned semantics, and portable artifacts.',
                        'LLM、VLM、AIGC、RAG 任务，具备样本 review、Judge 契约、语义版本与可携带产物。'
                      )}
                    </p>
                  </>
                </article>
                <article class="card">
                  <>
                    <Icon name="tabler:route-2" size="30" />
                    <h3>{t('Agent & Harness', 'Agent 与 Harness')}</h3>
                    <p>
                      {t(
                        'Measure requests, tools, tokens and outcomes across native agent evaluations and external harness workflows.',
                        '跨原生 Agent 评测和外部 Harness 工作流，测量请求、工具、token 与最终结果。'
                      )}
                    </p>
                  </>
                </article>
                <article class="card">
                  <>
                    <Icon name="tabler:activity-heartbeat" size="30" />
                    <h3>{t('Performance', '性能压测')}</h3>
                    <p>
                      {t(
                        'Turn concurrency, latency, RPS, TTFT and throughput into a repeatable service decision.',
                        '将并发、延迟、RPS、TTFT 与吞吐转化为可复现的服务决策。'
                      )}
                    </p>
                  </>
                </article>
              </>
            </div>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container split">
          <>
            <div>
              <>
                <p class="eyebrow">{t('EVIDENCE, NOT A SCORECARD', '证据，而非单一分数')}</p>
                <h2 class="section-title">
                  {t(`${count} benchmarks. One reproducible path.`, `${count} 个评测集。一条可复现路径。`)}
                </h2>
                <p class="lede">
                  {t(
                    'Inputs, predictions, reviews, reports, configuration, and versioned metadata remain connected so a result can be inspected instead of merely repeated.',
                    '输入、预测、review、报告、配置和版本化 metadata 彼此关联，结果可被审查，而不只是重复运行。'
                  )}
                </p>
              </>
            </div>
            <div class="evidence-path">
              {evidence.map(([name, detail]) => (
                <div class="evidence-step">
                  <strong>{name}</strong>
                  <span>{detail}</span>
                </div>
              ))}
            </div>
          </>
        </div>
      </section>
      <section class="section dark">
        <div class="container split">
          <>
            <div>
              <>
                <p class="eyebrow">{t('USE WITH AI', '让 AI 帮你用')}</p>
                <h2 class="section-title">
                  {t('Give an agent a precise, safe starting point.', '给 AI Agent 一个精确、安全的起点。')}
                </h2>
                <p class="lede">
                  {t(
                    'Copy a fixed prompt. It asks your coding agent to use the project skill, work through an API, limit to five samples, and avoid local model downloads.',
                    '复制固定 Prompt，让你的编码 Agent 使用项目 Skill、通过 API、仅运行五个样本，并避免下载本地模型。'
                  )}
                </p>
              </>
            </div>
            <PromptCard title={t('API-first evaluation prompt', 'API-first 评测 Prompt')} prompt={prompt} />
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <>
            <ClaimBadge status="exploring" locale={locale} />
            <h2 class="section-title">
              {t('Evaluation that stays trustworthy as the harness evolves.', 'Harness 迭代时，评测仍应值得信任。')}
            </h2>
            <p class="lede">
              {t(
                'We are exploring frozen artifacts, independent audits and selection records for evaluator evolution. Research prototypes are not shipped product features.',
                '我们正在探索用冻结产物、独立审计和选择记录来评估 evaluator 演进；研究原型不是已交付产品功能。'
              )}
            </p>
            <div class="button-row">
              <a class="button" href={to('/research')}>
                {t('Read research boundaries', '阅读研究边界')}
                <Icon name="tabler:arrow-right" />
              </a>
            </div>
          </>
        </div>
      </section>
    </>
  )
}

{
  page === 'evaluation' && (
    <>
      <section class="hero">
        <div class="container hero-grid">
          <>
            <div>
              <>
                <p class="eyebrow">{t('MODEL EVALUATION', '模型评测')}</p>
                <h1 class="display">
                  {t('Turn model output into defensible evidence.', '把模型输出转化为可辩护的证据。')}
                </h1>
                <p class="lede">
                  {t(
                    'Evaluate LLMs, VLMs, AIGC and RAG workloads with benchmark metadata, sample reviews, scoring contracts and reports that retain context.',
                    '通过 benchmark metadata、样本 review、评分契约和保留上下文的报告，评测 LLM、VLM、AIGC 与 RAG 工作负载。'
                  )}
                </p>
                <div class="tags">
                  <>
                    <span class="pill">LLM</span>
                    <span class="pill">VLM</span>
                    <span class="pill">AIGC</span>
                    <span class="pill">RAG</span>
                    <span class="pill">OpenAI-compatible API</span>
                  </>
                </div>
              </>
            </div>
            <ScreenshotFrame src={evalShot} alt="qwen-plus GSM8K evaluation dashboard" />
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <>
            <p class="eyebrow">{t('TRACEABLE BY DESIGN', '可追溯设计')}</p>
            <h2 class="section-title">
              {t('From a dataset row to the report you share.', '从一条数据到可分享的报告。')}
            </h2>
            <div class="evidence-path">
              {evidence.map(([name, detail]) => (
                <div class="evidence-step">
                  <strong>{name}</strong>
                  <span>{detail}</span>
                </div>
              ))}
            </div>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container two-col">
          <>
            <article class="panel">
              <>
                <ClaimBadge status="today" locale={locale} />
                <h3>{t('Versioned semantics', '语义版本化')}</h3>
                <p>
                  {t(
                    'Benchmark metadata publishes evaluation versions, so prompt, mapping, data or scoring changes can be visible.',
                    'Benchmark metadata 发布评测版本，使 prompt、映射、数据或评分变化可见。'
                  )}
                </p>
              </>
            </article>
            <article class="panel">
              <>
                <ClaimBadge status="today" locale={locale} />
                <h3>{t('Judge contracts', 'Judge 契约')}</h3>
                <p>
                  {t(
                    'Structured judge outputs fail closed when invalid; malformed replies do not quietly become scores.',
                    '结构化 Judge 输出在无效时 fail closed；格式错误的回复不会悄悄转成分数。'
                  )}
                </p>
              </>
            </article>
            <article class="panel">
              <>
                <ClaimBadge status="today" locale={locale} />
                <h3>{t('Portable artifacts', '可携带产物')}</h3>
                <p>
                  {t(
                    'Predictions, reviews, reports and configs remain together for local inspection and dashboard drill-down.',
                    '预测、review、报告和配置一同保留，支持本地审查和 Dashboard 下钻。'
                  )}
                </p>
              </>
            </article>
            <article class="panel">
              <>
                <h3>{t('Real demo context', '真实 Demo 上下文')}</h3>
                <p>
                  <br />
                  {t(
                    'Accuracy 100% · 5.188s average latency · 36.85 tok/s. A small API snapshot, not a general model ranking.',
                    'Accuracy 100% · 平均延迟 5.188s · 36.85 tok/s。小规模 API 快照，不代表普适模型排名。'
                  )}
                </p>
              </>
            </article>
          </>
        </div>
      </section>
      <section class="section dark">
        <div class="container split">
          <>
            <div>
              <>
                <h2 class="section-title">
                  {t(
                    'Start with one API call, not one checkpoint download.',
                    '从一次 API 调用开始，而非下载一个 checkpoint。'
                  )}
                </h2>
                <p class="lede">
                  {t(
                    'Use the API-first recipe and keep the first run bounded to five samples.',
                    '使用 API-first 配方，并将首次运行限制在五个样本。'
                  )}
                </p>
                <a class="button" href={to('/get-started')}>
                  {t('Get started', '开始使用')}
                  <Icon name="tabler:arrow-right" />
                </a>
              </>
            </div>
            <pre class="terminal">evalscope eval --model qwen-plus --datasets gsm8k --limit 5</pre>
          </>
        </div>
      </section>
    </>
  )
}

{
  page === 'agent' && (
    <>
      <section class="hero">
        <div class="container hero-grid">
          <>
            <div>
              <>
                <p class="eyebrow">{t('AGENT & HARNESS', 'AGENT 与 HARNESS')}</p>
                <h1 class="display">
                  {t('Measure the loop, not just the last answer.', '度量完整循环，而非只看最终答案。')}
                </h1>
                <p class="lede">
                  {t(
                    'Capture model requests, tool calls, token usage and final outcomes for agent tasks — with a path for external replay scenarios too.',
                    '记录 Agent 任务中的模型请求、工具调用、token 用量和最终结果，并支持外部回放场景。'
                  )}
                </p>
                <div class="tags">
                  <>
                    <span class="pill">Native agent evaluation</span>
                    <span class="pill">External scenarios</span>
                    <span class="pill">Function calling</span>
                  </>
                </div>
              </>
            </div>
            <ScreenshotFrame src={agentShot} alt="Real EvalScope Agent Details screenshot" />
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <>
            <p class="eyebrow">{t('MEASURED AGENT LOOP', '可度量 AGENT 循环')}</p>
            <div class="evidence-path">
              <>
                <div class="evidence-step">
                  <>
                    <strong>Request</strong>
                    <span>{t('Task and context', '任务与上下文')}</span>
                  </>
                </div>
                <div class="evidence-step">
                  <>
                    <strong>Reason</strong>
                    <span>{t('Model requests', '模型请求')}</span>
                  </>
                </div>
                <div class="evidence-step">
                  <>
                    <strong>Act</strong>
                    <span>{t('Tool call evidence', '工具调用证据')}</span>
                  </>
                </div>
                <div class="evidence-step">
                  <>
                    <strong>Verify</strong>
                    <span>{t('Outcome and review', '结果与 review')}</span>
                  </>
                </div>
              </>
            </div>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container two-col">
          <>
            <article class="panel">
              <>
                <ClaimBadge status="today" locale={locale} />
                <h3>{t('Native path', '原生路径')}</h3>
                <p>
                  {t(
                    'Run EvalScope agent benchmarks and retain the request, tool and result evidence that belongs to the benchmark artifact.',
                    '运行 EvalScope Agent benchmark，并保留属于 benchmark 产物的请求、工具和结果证据。'
                  )}
                </p>
              </>
            </article>
            <article class="panel">
              <>
                <ClaimBadge status="today" locale={locale} />
                <h3>{t('External path', '外部路径')}</h3>
                <p>
                  {t(
                    'Replay compatible serving scenarios such as AgentX through the performance workflow, preserving scenario provenance and validity state.',
                    '通过性能工作流回放如 AgentX 的兼容服务场景，保留场景溯源与有效性状态。'
                  )}
                </p>
              </>
            </article>
            <article class="panel">
              <>
                <h3>{t('Real event snapshot', '真实事件快照')}</h3>
                <p>
                  <br />
                  {t(
                    'This page intentionally uses Details evidence only. It does not represent a Dashboard trace interface.',
                    '本页仅使用 Details 证据，不展示虚构的 Dashboard Trace 界面。'
                  )}
                </p>
              </>
            </article>
            <article class="panel">
              <>
                <ClaimBadge status="exploring" locale={locale} />
                <h3>{t('Drift-aware harness evolution', '感知漂移的 Harness 演进')}</h3>
                <p>
                  {t(
                    'We are exploring frozen artifacts and independent audits for comparing harness revisions. This is not a shipped drift-prevention feature.',
                    '我们正在探索用冻结产物和独立审计比较 Harness 版本；这不是已交付的漂移防护功能。'
                  )}
                </p>
              </>
            </article>
          </>
        </div>
      </section>
      <section class="section dark">
        <div class="container">
          <>
            <h2 class="section-title">{t('Keep the research boundary visible.', '让研究边界始终清晰。')}</h2>
            <a class="button" href={to('/research')}>
              {t('Explore research protocol', '查看研究协议')}
              <Icon name="tabler:arrow-right" />
            </a>
          </>
        </div>
      </section>
    </>
  )
}

{
  page === 'performance' && (
    <>
      <section class="hero">
        <div class="container hero-grid">
          <>
            <div>
              <>
                <p class="eyebrow">{t('PERFORMANCE', '性能压测')}</p>
                <h1 class="display">
                  {t('Load tests that lead to an operational decision.', '让压测导向真实的运营决策。')}
                </h1>
                <p class="lede">
                  {t(
                    'Compare serving behavior with RPS, latency, TTFT, throughput, concurrency and success rate — then inspect charts and output artifacts.',
                    '用 RPS、延迟、TTFT、吞吐、并发与成功率比较服务行为，再审查图表与输出产物。'
                  )}
                </p>
                <div class="tags">
                  <>
                    <span class="pill">Closed loop</span>
                    <span class="pill">Open loop</span>
                    <span class="pill">API-first</span>
                  </>
                </div>
              </>
            </div>
            <ScreenshotFrame src={perfShot} alt="Real EvalScope qwen-plus performance overview" />
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <>
            <p class="eyebrow">{t('REAL API SNAPSHOT', '真实 API 快照')}</p>
            <h2 class="section-title">{t('One small run, six decision metrics.', '一次小规模运行，六项决策指标。')}</h2>
            <div class="card-grid">
              <>
                <article class="card">
                  <>
                    <div class="metric">2.08</div>
                    <div class="metric-label">Best RPS</div>
                    <h3>24 {t('requests', '个请求')}</h3>
                    <p>1536 {t('output tokens', '输出 token')} · 20.24s</p>
                  </>
                </article>
                <article class="card">
                  <>
                    <div class="metric">1.713s</div>
                    <div class="metric-label">{t('lowest latency', '最低延迟')}</div>
                    <h3>133.22 tok/s</h3>
                    <p>{t('at concurrency 4', '并发 4')}</p>
                  </>
                </article>
                <article class="card">
                  <>
                    <div class="metric">100%</div>
                    <div class="metric-label">{t('success rate', '成功率')}</div>
                    <h3>374.85ms TTFT</h3>
                    <p>{t('at concurrency 4', '并发 4')}</p>
                  </>
                </article>
              </>
            </div>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container split">
          <>
            <div>
              <>
                <h2 class="section-title">
                  {t('Choose the arrival model before you interpret the curve.', '解读曲线之前，先选择到达模型。')}
                </h2>
                <div class="two-col">
                  <>
                    <article class="panel">
                      <>
                        <h3>Closed loop</h3>
                        <p>
                          {t(
                            'Each virtual user sends its next request after the previous response. Useful for interactive capacity behavior.',
                            '每位虚拟用户在上一个响应后再发下一请求，适合交互式容量行为。'
                          )}
                        </p>
                      </>
                    </article>
                    <article class="panel">
                      <>
                        <h3>Open loop</h3>
                        <p>
                          {t(
                            'Requests arrive at a target rate, independent of completion. Useful for arrival-pressure experiments.',
                            '请求按目标速率到达，不依赖完成，适合到达压力实验。'
                          )}
                        </p>
                      </>
                    </article>
                  </>
                </div>
              </>
            </div>
            <ScreenshotFrame src={perfCharts} alt="Real EvalScope qwen-plus performance charts" />
          </>
        </div>
      </section>
      <section class="section dark">
        <div class="container split">
          <>
            <div>
              <>
                <h2 class="section-title">
                  {t('Bound the first run. Keep artifacts.', '限制首次运行规模，保留产物。')}
                </h2>
                <p class="lede">
                  {t(
                    'No model weights or GPU are required when testing a compatible API.',
                    '测试兼容 API 时，无需模型权重或 GPU。'
                  )}
                </p>
                <a class="button" href={to('/get-started')}>
                  {t('Run an API test', '运行 API 压测')}
                  <Icon name="tabler:arrow-right" />
                </a>
              </>
            </div>
            <pre class="terminal">evalscope perf --model qwen-plus --number 24 --parallel 1 2 4</pre>
          </>
        </div>
      </section>
    </>
  )
}

{
  page === 'benchmarks' && (
    <>
      <section class="hero">
        <div class="container">
          <>
            <p class="eyebrow">{t('BENCHMARK CATALOG', 'BENCHMARK 目录')}</p>
            <h1 class="display">{t('Find the evidence surface your system needs.', '找到你的系统需要的证据表面。')}</h1>
            <p class="lede">
              {t(
                `${count} benchmark metadata records are read from the current EvalScope branch at build time. Sync main into website when the catalog needs a reviewed refresh.`,
                `${count} 条 benchmark metadata 在构建时从当前 EvalScope 分支读取。需要更新目录时，人工将 main 合并进 website。`
              )}
            </p>
            <div class="tags">
              <>
                <span class="pill">LLM</span>
                <span class="pill">VLM</span>
                <span class="pill">Agent</span>
                <span class="pill">AIGC</span>
                <span class="pill">Build-time metadata</span>
              </>
