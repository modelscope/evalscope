---
import { Icon } from 'astro-icon/components';
import agentShot from '../assets/demo/agent-qwen-plus-gsm8k.png';
import evalShot from '../assets/demo/evaluation-qwen-plus-gsm8k.png';
import perfCharts from '../assets/demo/performance-qwen-plus-charts.png';
import perfShot from '../assets/demo/performance-qwen-plus-overview.png';
import researchSpiral from '../assets/illustrations/research-spiral.png';
import { localizePath } from '../data/site';
import { getBenchmarkCatalog } from '../lib/benchmarks';
import type { Locale, PageSlug } from '../types';
import BenchmarkCatalog from './BenchmarkCatalog.astro';
import ClaimBadge from './ClaimBadge.astro';
import CodeSnippet from './CodeSnippet.astro';
import PromptCard from './PromptCard.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';

interface Props {
  page?: PageSlug;
  locale: Locale;
}
const { page, locale } = Astro.props;
const zh = locale === 'zh';
const count = getBenchmarkCatalog().length;
const t = (en: string, cn: string) => (zh ? cn : en);
const to = (path: '/' | `/${PageSlug}`) => localizePath(path, locale);
const prompt = t(
  'Use the EvalScope project skill to configure and run a 5-sample GSM8K evaluation against my OpenAI-compatible API. Do not download a local model or use a GPU. Read the relevant skill reference, use my API key from an environment variable, report the score and artifact path, then show me how to open the local dashboard.',
  '请使用 EvalScope 项目 Skill，针对我的 OpenAI-compatible API 配置并运行 GSM8K 的 5 条样本评测。不要下载本地模型，也不要使用 GPU。先阅读相关 Skill，从环境变量读取 API key，输出分数与产物路径，并说明如何打开本地 Dashboard。'
);
const evidence = [
  ['Dataset', t('Versioned samples', '版本化样本')],
  ['Prediction', t('Model or API output', '模型或 API 输出')],
  ['Review', t('Scoring evidence', '评分证据')],
  ['Report', t('Decision artifacts', '决策产物')],
];
const evalCommand = `export DASHSCOPE_API_KEY='…'
evalscope eval \\
  --model qwen-plus \\
  --datasets gsm8k \\
  --limit 5`;
const serviceCommand = `pip install 'evalscope[service]'
evalscope service --outputs ./outputs`;
const perfCommand = `evalscope perf \\
  --model qwen-plus \\
  --number 24 \\
  --parallel 1 2 4`;
---

{
  !page && (
    <>
      <section class="hero">
        <div class="container hero-grid">
          <>
            <div>
              <>
                <p class="registration">
                  <>
                    <span>Evaluate</span>
                    <span class="index">00</span>
                  </>
                </p>
                <p class="eyebrow">{t('OPEN-SOURCE EVALUATION INFRASTRUCTURE', '开源 AI 评测基础设施')}</p>
                <h1 class="display">
                  {t(
                    'From model quality to system performance — evaluate it all with EvalScope.',
                    '从模型能力到系统性能，用 EvalScope 统一评测。'
                  )}
                </h1>
                <div class="gold-line" />
                <p class="lede">
                  {t(
                    'One evidence path for LLMs, VLMs, agents, benchmarks, load tests, and the artifacts behind every decision.',
                    '一条可追溯的证据路径，覆盖 LLM、VLM、Agent、评测集、压测与每个决策背后的产物。'
                  )}
                </p>
                <div class="button-row">
                  <>
                    <a class="button" href={to('/get-started')}>
                      {t('Use with AI', '让 AI 帮你用')}
                      <Icon name="tabler:sparkles" />
                    </a>
                    <a
                      class="button alt"
                      href="https://github.com/modelscope/evalscope"
                      target="_blank"
                      rel="noreferrer"
                    >
                      {t('View on GitHub', '在 GitHub 查看')}
                      <Icon name="tabler:brand-github" />
                    </a>
                  </>
                </div>
              </>
            </div>
            <div class="hero-stack">
              <CodeSnippet code={evalCommand} label="run-evaluation.sh" />
              <ScreenshotFrame src={evalShot} alt="Real EvalScope qwen-plus GSM8K results" />
            </div>
          </>
        </div>
      </section>
      <div class="container">
        <>
          <div class="measurement-rule" />
          <div class="instrument-strip">
            <>
              <div>
                <>
                  <strong>{count}</strong>
                  <span>{t('Benchmarks', '评测集')}</span>
                </>
              </div>
              <div>
                <>
                  <strong>LLM · VLM · AIGC</strong>
                  <span>{t('Evaluation layers', '评测层')}</span>
                </>
              </div>
              <div>
                <>
                  <strong>JSON · HTML · local</strong>
                  <span>{t('Portable evidence artifacts', '可携带证据产物')}</span>
                </>
              </div>
              <div>
                <>
                  <strong>Apache-2.0</strong>
                  <span>{t('Open source license', '开源许可')}</span>
                </>
              </div>
            </>
          </div>
        </>
      </div>
      <section class="section">
        <div class="container">
          <>
            <p class="eyebrow">{t('ONE SYSTEM, THREE MEASUREMENT SURFACES', '一个系统，三种测量视角')}</p>
            <h2 class="section-title">{t('Make every AI release legible.', '让每一次 AI 发布都有据可查。')}</h2>
            <div class="card-grid">
              <>
                <article class="card">
                  <>
                    <Icon name="tabler:scale" size="30" />
                    <h3>{t('Evaluation', '模型评测')}</h3>
                    <p>
                      {t(
                        'LLM, VLM, AIGC and RAG tasks with sample reviews, judge contracts, versioned semantics, and portable artifacts.',
                        'LLM、VLM、AIGC、RAG 任务，具备样本 review、Judge 契约、语义版本与可携带产物。'
                      )}
                    </p>
                  </>
                </article>
                <article class="card">
                  <>
                    <Icon name="tabler:route-2" size="30" />
                    <h3>{t('Agent & Harness', 'Agent 与 Harness')}</h3>
                    <p>
                      {t(
                        'Measure requests, tools, tokens and outcomes across native agent evaluations and external harness workflows.',
                        '跨原生 Agent 评测和外部 Harness 工作流，测量请求、工具、token 与最终结果。'
                      )}
                    </p>
                  </>
                </article>
                <article class="card">
                  <>
                    <Icon name="tabler:activity-heartbeat" size="30" />
                    <h3>{t('Performance', '性能压测')}</h3>
                    <p>
                      {t(
                        'Turn concurrency, latency, RPS, TTFT and throughput into a repeatable service decision.',
                        '将并发、延迟、RPS、TTFT 与吞吐转化为可复现的服务决策。'
                      )}
                    </p>
                  </>
                </article>
              </>
            </div>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container split">
          <>
            <div>
              <>
                <p class="eyebrow">{t('EVIDENCE, NOT A SCORECARD', '证据，而非单一分数')}</p>
                <h2 class="section-title">
                  {t(`${count} benchmarks. One reproducible path.`, `${count} 个评测集。一条可复现路径。`)}
                </h2>
                <p class="lede">
                  {t(
                    'Inputs, predictions, reviews, reports, configuration, and versioned metadata remain connected so a result can be inspected instead of merely repeated.',
                    '输入、预测、review、报告、配置和版本化 metadata 彼此关联，结果可被审查，而不只是重复运行。'
                  )}
                </p>
              </>
            </div>
            <div class="evidence-path">
              {evidence.map(([name, detail]) => (
                <div class="evidence-step">
                  <strong>{name}</strong>
                  <span>{detail}</span>
                </div>
              ))}
            </div>
          </>
        </div>
      </section>
      <section class="section dark">
        <div class="container split">
          <>
            <div>
              <>
                <p class="eyebrow">{t('USE WITH AI', '让 AI 帮你用')}</p>
                <h2 class="section-title">
                  {t('Give an agent a precise, safe starting point.', '给 AI Agent 一个精确、安全的起点。')}
                </h2>
                <p class="lede">
                  {t(
                    'Copy a fixed prompt. It asks your coding agent to use the project skill, work through an API, limit to five samples, and avoid local model downloads.',
                    '复制固定 Prompt，让你的编码 Agent 使用项目 Skill、通过 API、仅运行五个样本，并避免下载本地模型。'
                  )}
                </p>
              </>
            </div>
            <PromptCard title={t('API-first evaluation prompt', 'API-first 评测 Prompt')} prompt={prompt} />
          </>
        </div>
      </section>
      <section class="section">
        <div class="container two-col">
          <>
            <div>
              <>
                <div class="section-register">
                  <>
                    <div>
                      <h2 class="section-title tight">{t('Manual quick start.', '手动快速开始。')}</h2>
                    </div>
                    <p>{t('Copy · paste · run', '复制 · 粘贴 · 运行')}</p>
                  </>
                </div>
                <CodeSnippet code={evalCommand} label="run-evaluation.sh" />
              </>
            </div>
            <article class="panel">
              <>
                <h3>{t('API-first, no local GPU required.', 'API-first，无需本地 GPU。')}</h3>
                <p>
                  {t(
                    'Your key stays in the environment. The first evaluation is deliberately limited to five samples, then artifacts show exactly what ran.',
                    'key 保持在环境变量中。首次评测有意限制为五个样本，之后产物完整展示实际运行内容。'
                  )}
                </p>
                <div class="tags">
                  <>
                    <span class="pill">API endpoint</span>
                    <span class="pill">5-sample smoke</span>
                    <span class="pill">No model download</span>
                  </>
                </div>
              </>
            </article>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <>
            <ClaimBadge status="exploring" locale={locale} />
            <h2 class="section-title">
              {t('Evaluation that stays trustworthy as the harness evolves.', 'Harness 迭代时，评测仍应值得信任。')}
            </h2>
            <p class="lede">
              {t(
                'We are exploring frozen artifacts, independent audits and selection records for evaluator evolution. Research prototypes are not shipped product features.',
                '我们正在探索用冻结产物、独立审计和选择记录来评估 evaluator 演进；研究原型不是已交付产品功能。'
              )}
            </p>
            <div class="button-row">
              <a class="button" href={to('/research')}>
                {t('Read research boundaries', '阅读研究边界')}
                <Icon name="tabler:arrow-right" />
              </a>
            </div>
          </>
        </div>
      </section>
    </>
  )
}

{
  page === 'evaluation' && (
    <>
      <section class="hero">
        <div class="container hero-grid">
          <>
            <div>
              <>
                <p class="registration">
                  <>
                    <span>{t('Evaluation', '模型评测')}</span>
                    <span class="index">01</span>
