                    )}
                  </p>
                </>
              </article>
              <article class="card">
                <>
                  <ClaimBadge status="today" locale={locale} />
                  <h3>{t('Portable artifacts', '可携带产物')}</h3>
                  <p>
                    {t(
                      'Predictions, reviews, reports and configs remain together for local inspection and dashboard drill-down.',
                      '预测、review、报告和配置一同保留，支持本地审查和 Dashboard 下钻。'
                    )}
                  </p>
                </>
              </article>
            </>
          </div>
        </div>
      </section>
      <section class="section dark">
        <div class="container split">
          <>
            <div>
              <>
                <h2 class="section-title">
                  {t(
                    'Start with one API call, not one checkpoint download.',
                    '从一次 API 调用开始，而非下载一个 checkpoint。'
                  )}
                </h2>
                <p class="lede">
                  {t(
                    'Use the API-first recipe and keep the first run bounded to five samples.',
                    '使用 API-first 配方，并将首次运行限制在五个样本。'
                  )}
                </p>
                <a class="button" href={to('/get-started')}>
                  {t('Get started', '开始使用')}
                  <Icon name="tabler:arrow-right" />
                </a>
              </>
            </div>
            <CodeSnippet code={evalCommand} label="run-evaluation.sh" />
          </>
        </div>
      </section>
