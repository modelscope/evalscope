---
import { Icon } from 'astro-icon/components';
import agentTraceExistingLight from '../assets/demo/agent-trace-existing-light.png';
import dashboardExistingLight from '../assets/demo/dashboard-existing-light.png';
import evaluationOverviewExistingLight from '../assets/demo/evaluation-overview-existing-light.png';
import evalShot from '../assets/demo/evaluation-qwen-plus-gsm8k.png';
import performanceExistingLight from '../assets/demo/performance-existing-light.png';
import perfCharts from '../assets/demo/performance-qwen-plus-charts.png';
import perfShot from '../assets/demo/performance-qwen-plus-overview.png';
import agentTraceHero from '../assets/illustrations/agent-trace-hero.png';
import evaluationEvidenceHero from '../assets/illustrations/evaluation-evidence-hero.png';
import performanceDecisionHero from '../assets/illustrations/performance-decision-hero.png';
import researchSpiral from '../assets/illustrations/research-spiral.png';
import visualizationEvidenceHero from '../assets/illustrations/visualization-evidence-hero.png';
import { localizePath } from '../data/site';
import { getBenchmarkCatalog } from '../lib/benchmarks';
import type { Locale, PageSlug } from '../types';
import BenchmarkCatalog from './BenchmarkCatalog.astro';
import ClaimBadge from './ClaimBadge.astro';
import CodeSnippet from './CodeSnippet.astro';
import PromptCard from './PromptCard.astro';
import ProductTourIndex from './ProductTourIndex.astro';
import QuickstartPanel from './QuickstartPanel.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';
import TaskTabs from './TaskTabs.astro';

interface Props {
  page?: PageSlug;
  locale: Locale;
}
const { page, locale } = Astro.props;
const zh = locale === 'zh';
const count = getBenchmarkCatalog().length;
const t = (en: string, cn: string) => (zh ? cn : en);
const to = (path: '/' | `/${PageSlug}`) => localizePath(path, locale);
const skillUrl = 'https://github.com/modelscope/evalscope/tree/main/skills/evalscope';
const docsFaqUrl = zh
  ? 'https://evalscope.readthedocs.io/zh-cn/latest/get_started/faq.html'
  : 'https://evalscope.readthedocs.io/en/latest/get_started/faq.html';
const skillInstallPrompt = `Install the EvalScope project skill from ${skillUrl}. Read it after installation, then tell me what you need from me before using EvalScope.`;
const prompt =
  'Use the EvalScope project skill to evaluate qwen-plus on five GSM8K samples. Ask me for the model or endpoint configuration you need before running it, then report the results and where the outputs were saved.';
const evidence = [
  [
    'Dataset',
    t('Versioned samples', '版本化样本'),
    t(
      'The selected dataset and version define what the run is allowed to measure.',
      '选定的数据集与版本定义了本次运行能够度量的范围。'
    ),
  ],
  [
    'Prediction',
    t('Model or API output', '模型或 API 输出'),
    t(
      'Raw model responses remain attached to the input that produced them.',
      '原始模型响应会与产生它们的输入保持关联。'
    ),
  ],
  [
    'Review',
    t('Scoring evidence', '评分证据'),
    t(
      'A review records the scoring contract, verdict and any failure boundary.',
      'Review 会记录评分契约、判定结果以及任何失败边界。'
    ),
  ],
  [
    'Report',
    t('Decision artifacts', '决策产物'),
    t(
      'The report links summaries back to samples, configs and portable outputs.',
      '报告将汇总结果关联回样本、配置和可携带产物。'
    ),
  ],
];
const evalCommand = `export DASHSCOPE_API_KEY='…'
evalscope eval \\
  --model qwen-plus \\
  --api-key "$DASHSCOPE_API_KEY" \\
  --datasets gsm8k \\
  --limit 5`;
const serviceCommand = `pip install 'evalscope[service]'
evalscope service --outputs ./outputs`;
const quickstartCommand = `pip install 'evalscope[service]'
export DASHSCOPE_API_KEY='…'
evalscope eval \\
  --model qwen-plus \\
  --api-key "$DASHSCOPE_API_KEY" \\
  --datasets gsm8k \\
  --limit 5
evalscope service --outputs ./outputs`;
const perfCommand = `evalscope perf \\
  --model qwen-plus \\
  --number 24 \\
  --parallel 1 2 4`;
---

{
  !page && (
    <>
      <section id="overview" class="hero hero--reference" data-product-section>
        <div class="container hero-grid">
          <>
            <div class="hero-copy">
              <>
                <p class="eyebrow">{t('OPEN-SOURCE EVALUATION INFRASTRUCTURE', '开源 AI 评测基础设施')}</p>
                <h1 class="display">
                  {t('Evaluate every AI system — with evidence you can inspect.', '评测每个 AI 系统，证据全程可查。')}
                </h1>
                <div class="gold-line" />
                <p class="lede">
                  {t(
                    'One evidence path for LLMs, VLMs, agents, benchmarks, load tests, and the artifacts behind every decision.',
                    '一条可追溯的证据路径，覆盖 LLM、VLM、Agent、评测集、压测与每个决策背后的产物。'
                  )}
                </p>
                <div class="button-row">
                  <>
                    <a class="button" href={to('/get-started')}>
                      {t('Use with AI', '让 AI 帮你用')}
                      <Icon name="tabler:sparkles" />
                    </a>
                    <a
                      class="button alt"
                      href="https://github.com/modelscope/evalscope"
                      target="_blank"
                      rel="noreferrer"
                    >
                      {t('View on GitHub', '在 GitHub 查看')}
                      <Icon name="tabler:brand-github" />
                    </a>
                  </>
                </div>
                <div class="hero-progress-copy" aria-hidden="true">
                  <i />
                  <span class="hero-progress-copy__ticks" />
                  <p>
                    TURN MODELS INTO MEASURABLE PROGRESS
                    <br />
                    EVALSCOPE&nbsp;&nbsp;//&nbsp;&nbsp;OPEN SOURCE&nbsp;&nbsp;//&nbsp;&nbsp;FOR A MORE CAPABLE AI
                    ECOSYSTEM
                  </p>
                </div>
              </>
            </div>
            <div class="hero-stack stage-card" data-stage-card>
              <CodeSnippet code={evalCommand} label="run-evaluation.sh" locale={locale} />
              <ScreenshotFrame src={evalShot} alt="Real EvalScope qwen-plus GSM8K results" />
            </div>
            <aside class="hero-side-reference" aria-hidden="true">
              <i class="reference-cross reference-cross--top" />
              <p>
                SAME
                <br />
                PROMPTS
                <br />
                BETTER
                <br />
                INSIGHTS
              </p>
              <span class="reference-ruler" />
              <p>
                DATA
                <br />
                MODELS
                <br />
                PERFORMANCE
                <br />
                REAL PROGRESS
              </p>
              <i class="reference-cross reference-cross--bottom" />
              <small>
                EVALUATION
                <br />
                FOR A BRIGHTER
                <br />
                AI TOMORROW
              </small>
            </aside>
          </>
        </div>
      </section>
      <div class="container">
        <div class="hero-measurement-band" aria-hidden="true">
          <p>
            A CLEARER PICTURE
            <br />
            FOR HIGHER CAPABILITY
          </p>
          <i />
          <div class="hero-measurement-band__ruler">
            <>
              <span>0</span>
              <span>50</span>
              <span>100</span>
              <span>200</span>
              <span>300</span>
              <span>400</span>
            </>
          </div>
          <strong>EVALSCOPE</strong>
        </div>
      </div>
      <section class="section">
        <div class="container">
          <>
            <p class="eyebrow">{t('ONE SYSTEM, THREE MEASUREMENT SURFACES', '一个系统，三种测量视角')}</p>
            <h2 class="section-title">{t('Make every AI release legible.', '让每一次 AI 发布都有据可查。')}</h2>
            <div class="card-grid">
              <>
                <article class="card">
                  <>
                    <div class="surface-mark">
                      <>
                        <span>01</span>
                        <span class="surface-mark__icon">
                          <Icon name="tabler:scale" size="20" />
                        </span>
                      </>
                    </div>
                    <h3>{t('Evaluation', '模型评测')}</h3>
                    <p>
                      {t(
                        'LLM, VLM, AIGC and RAG tasks with sample reviews, judge contracts, versioned semantics, and portable artifacts.',
                        'LLM、VLM、AIGC、RAG 任务，具备样本 review、Judge 契约、语义版本与可携带产物。'
                      )}
                    </p>
                  </>
                </article>
                <article class="card">
                  <>
                    <div class="surface-mark">
                      <>
                        <span>02</span>
                        <span class="surface-mark__icon">
                          <Icon name="tabler:route-2" size="20" />
                        </span>
                      </>
                    </div>
                    <h3>{t('Agent & Harness', 'Agent 与 Harness')}</h3>
                    <p>
                      {t(
                        'Measure requests, tools, tokens and outcomes across native agent evaluations and external harness workflows.',
                        '跨原生 Agent 评测和外部 Harness 工作流，测量请求、工具、token 与最终结果。'
                      )}
                    </p>
                  </>
                </article>
                <article class="card">
                  <>
                    <div class="surface-mark">
                      <>
                        <span>03</span>
                        <span class="surface-mark__icon">
                          <Icon name="tabler:activity-heartbeat" size="20" />
                        </span>
                      </>
                    </div>
                    <h3>{t('Performance', '性能压测')}</h3>
                    <p>
                      {t(
                        'Turn concurrency, latency, RPS, TTFT and throughput into a repeatable service decision.',
                        '将并发、延迟、RPS、TTFT 与吞吐转化为可复现的服务决策。'
                      )}
                    </p>
                  </>
                </article>
              </>
            </div>
          </>
        </div>
      </section>
      <section id="evaluation" class="section evidence-section" data-product-section>
        <div class="container">
          <>
            <div class="evidence-heading">
              <>
                <p class="eyebrow">{t('EVIDENCE, NOT A SCORECARD', '证据，而非单一分数')}</p>
                <h2 class="section-title evidence-title">
                  {t('One reproducible path from input to decision.', '从输入到决策，一条可复现的路径。')}
                </h2>
                <p class="lede">
                  {t(
                    'Inputs, predictions, reviews, reports, configuration, and versioned metadata remain connected so a result can be inspected instead of merely repeated.',
                    '输入、预测、review、报告、配置和版本化 metadata 彼此关联，结果可被审查，而不只是重复运行。'
                  )}
                </p>
              </>
            </div>
            <div class="evidence-stage evidence-stage--compact stage-card" data-evidence-board data-stage-card>
              <div class="evidence-brief">
                <span>{t('Select a record to inspect', '选择一条记录进行审查')}</span>
                <strong>{t('Connected evidence', '相连的证据')}</strong>
              </div>
              <div class="evidence-path">
                {evidence.map(([name, detail, context], index) => (
                  <button
                    class:list={['evidence-step', { active: index === 0 }]}
                    type="button"
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-evidence-step
                    data-evidence-name={name}
                    data-evidence-detail={detail}
                    data-evidence-context={context}
                    data-evidence-index={String(index + 1).padStart(2, '0')}
                  >
                    <strong>{name}</strong>
                    <span>{detail}</span>
                  </button>
                ))}
              </div>
              <div class="evidence-inspector" aria-live="polite">
                <span data-evidence-output-index>01</span>
                <strong data-evidence-output-name>Dataset</strong>
                <p data-evidence-output-context>{evidence[0][2]}</p>
              </div>
            </div>
          </>
        </div>
      </section>
      <section id="agent" class="section product-chapter" data-product-section>
        <div class="container split">
          <>
            <div>
              <p class="eyebrow">{t('AGENT & HARNESS', 'AGENT 与 HARNESS')}</p>
              <h2 class="section-title">
                {t('Trace the work behind an agent answer.', '追踪 Agent 答案背后的执行过程。')}
              </h2>
              <p class="lede">
                {t(
                  'Keep model requests, tool calls, token use and the submitted outcome in one inspectable task record.',
                  '将模型请求、工具调用、Token 用量和提交结果保留在同一份可审查的任务记录中。'
                )}
              </p>
              <div class="tags">
                <span class="pill">{t('Task context', '任务上下文')}</span>
                <span class="pill">{t('Tool evidence', '工具证据')}</span>
                <span class="pill">{t('Final outcome', '最终结果')}</span>
              </div>
              <div class="button-row">
                <a class="button alt" href={to('/agent')}>
                  {t('Open Agent details', '查看 Agent 详情')} <Icon name="tabler:arrow-right" />
                </a>
              </div>
            </div>
            <div class="stage-card" data-stage-card>
              <ScreenshotFrame
                src={agentTraceExistingLight}
                alt="Light Agent Trace with model requests and tool calls"
              />
            </div>
          </>
        </div>
      </section>
      <section id="performance" class="section dark" data-product-section>
        <div class="container split">
          <>
            <div>
              <p class="eyebrow">{t('PERFORMANCE', '性能压测')}</p>
              <h2 class="section-title">
                {t('Choose capacity with evidence, not a single number.', '用证据而非单个数字做容量决策。')}
              </h2>
              <p class="lede">
                {t(
                  'Compare concurrency, latency, TTFT, throughput and success rate in one run record, then keep the charts with their configuration.',
                  '在同一份运行记录中比较并发、延迟、TTFT、吞吐与成功率，并让图表始终与配置关联。'
                )}
              </p>
              <div class="button-row">
                <a class="button alt" href={to('/performance')}>
                  {t('Open performance details', '查看性能细节')} <Icon name="tabler:arrow-right" />
                </a>
              </div>
            </div>
            <div class="stage-card" data-stage-card>
              <ScreenshotFrame src={performanceExistingLight} alt="Light performance charts and run comparison" />
            </div>
          </>
        </div>
      </section>
      <section id="benchmarks" class="section product-chapter" data-product-section>
        <div class="container split">
          <>
            <div>
              <p class="eyebrow">{t('BENCHMARK CATALOG', 'BENCHMARK 目录')}</p>
              <h2 class="section-title">
                {t('Find the benchmark that fits the question.', '找到真正匹配问题的评测集。')}
              </h2>
              <p class="lede">
                {t(
                  'Browse task type, modality, metrics and evaluation version before you run. The catalog stays tied to generated documentation and runnable metadata.',
                  '在运行前查看任务类型、模态、指标与评测版本；目录始终关联自动生成的文档与可运行 metadata。'
                )}
              </p>
              <div class="button-row">
                <a class="button" href={to('/benchmarks')}>
                  {t('Browse all benchmarks', '浏览全部评测集')} <Icon name="tabler:arrow-right" />
                </a>
              </div>
            </div>
            <div
              class="catalog-preview stage-card"
              data-stage-card
              aria-label={t('Benchmark catalog overview', '评测集目录概览')}
            >
              <strong>250+</strong>
              <span>{t('benchmarks in the registry', '个评测集已收录')}</span>
              <div>
                <>
                  <span>LLM</span>
                  <span>VLM</span>
                  <span>Agent</span>
                  <span>AIGC</span>
                </>
              </div>
            </div>
          </>
        </div>
      </section>
      <section id="visualization" class="section product-chapter" data-product-section>
        <div class="container">
          <p class="eyebrow">{t('EVIDENCE VIEWS', '证据视图')}</p>
          <h2 class="section-title">{t('Follow every metric back to its evidence.', '从指标追溯到完整证据。')}</h2>
          <div class="button-row">
            <a class="button alt" href={to('/visualization')}>
              {t('Open Visualization details', '查看可视化详情')} <Icon name="tabler:arrow-right" />
            </a>
          </div>
          <div class="four-view-grid home-evidence-views">
            <div class="stage-card" data-stage-card>
              <ScreenshotFrame src={dashboardExistingLight} alt="Light Dashboard overview" />
            </div>
            <div class="stage-card" data-stage-card>
              <ScreenshotFrame src={evaluationOverviewExistingLight} alt="Light evaluation overview" />
            </div>
            <div class="stage-card" data-stage-card>
              <ScreenshotFrame src={performanceExistingLight} alt="Light performance overview" />
            </div>
            <div class="stage-card" data-stage-card>
              <ScreenshotFrame src={agentTraceExistingLight} alt="Light Agent Trace overview" />
            </div>
          </div>
        </div>
      </section>
      <section id="get-started" class="section dark" data-product-section>
        <div class="container">
          <div class="home-get-started-intro">
            <div data-stage-card>
              <p class="eyebrow">{t('GET STARTED', '开始使用')}</p>
              <h2 class="section-title">
                {t('Start with an agent or one command.', '让 AI 帮你用，或一条命令开始。')}
              </h2>
              <p class="lede">
                {t(
                  'Start a small API-backed evaluation with a coding agent or from the terminal. Both paths keep the same evidence.',
                  '通过 AI 编程助手或终端启动一次小型 API 评测；两条路径都会保留同一套证据。'
                )}
              </p>
            </div>
            <div data-stage-card>
              <p class="get-started-guide-copy">
                {t(
                  'Need endpoint setup, task prompts or troubleshooting? Continue with the complete guide.',
                  '需要 API 端点配置、任务提示词或排错说明？请继续阅读完整指南。'
                )}
              </p>
              <div class="button-row">
                <a class="button alt" href={to('/get-started')}>
                  {t('Open full setup guide', '打开完整使用指南')} <Icon name="tabler:arrow-right" />
                </a>
              </div>
            </div>
          </div>
          <div class="get-started-paths">
            <div class="stage-card" data-stage-card>
              <p class="eyebrow">{t('USE WITH AI', '让 AI 帮你用')}</p>
              <PromptCard title={t('AI evaluation handoff', '交给 AI 的评测说明')} prompt={prompt} locale={locale} />
            </div>
            <div class="stage-card command-path" data-stage-card>
              <p class="eyebrow">{t('COMMAND LINE', '命令行')}</p>
              <QuickstartPanel code={quickstartCommand} locale={locale} />
            </div>
          </div>
        </div>
      </section>
      <ProductTourIndex locale={locale} />
    </>
  )
}

{
  page === 'evaluation' && (
    <>
      <section class="hero">
        <div class="container hero-grid">
          <>
            <div>
              <>
                <p class="eyebrow">{t('MODEL EVALUATION', '模型评测')}</p>
                <h1 class="display">
                  {t('Turn model output into defensible evidence.', '把模型输出转化为可辩护的证据。')}
                </h1>
                <p class="lede">
                  {t(
                    'Evaluate LLMs, VLMs, AIGC and RAG workloads with benchmark metadata, sample reviews, scoring contracts and reports that retain context.',
                    '通过 benchmark metadata、样本 review、评分契约和保留上下文的报告，评测 LLM、VLM、AIGC 与 RAG 工作负载。'
                  )}
                </p>
                <div class="tags">
                  <>
                    <span class="pill">LLM</span>
                    <span class="pill">VLM</span>
                    <span class="pill">AIGC</span>
                    <span class="pill">RAG</span>
                    <span class="pill">OpenAI-compatible API</span>
                  </>
                </div>
              </>
            </div>
            <figure class="visual-frame hero-illustration-frame">
              <img
                class="hero-illustration"
                src={evaluationEvidenceHero.src}
                width={evaluationEvidenceHero.width}
                height={evaluationEvidenceHero.height}
                alt={t('Abstract evaluation evidence path', '抽象的评测证据路径')}
              />
            </figure>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container" data-evidence-board>
          <>
            <div class="section-register">
              <>
                <div>
                  <>
                    <p class="eyebrow">{t('BROAD MODEL COVERAGE', '广泛模型覆盖')}</p>
                    <h2 class="section-title tight">
                      {t('One interface for every evaluation layer.', '一个接口覆盖每个评测层。')}
                    </h2>
                  </>
                </div>
                <p>{t('Models · tasks · datasets · metrics', '模型 · 任务 · 数据集 · 指标')}</p>
              </>
            </div>
            <div class="instrument-strip">
              <>
                <div>
                  <>
                    <strong>LLM</strong>
                    <span>{t('Language models and custom benchmarks', '语言模型与自定义 benchmark')}</span>
                  </>
                </div>
                <div>
                  <>
                    <strong>VLM</strong>
                    <span>{t('Vision-language and multimodal tasks', '视觉语言与多模态任务')}</span>
                  </>
                </div>
                <div>
                  <>
                    <strong>AIGC</strong>
                    <span>{t('Text-to-image and image editing', '文生图与图像编辑')}</span>
                  </>
                </div>
                <div>
                  <>
                    <strong>RAG</strong>
                    <span>{t('Retrieval and generation quality', '检索与生成质量')}</span>
                  </>
                </div>
              </>
            </div>
            <h2 class="section-title evidence-path-title" style="margin-top:64px">
              {t('From a dataset row to the report you share.', '从一条数据到可分享的报告。')}
            </h2>
            <div class="evidence-path">
              {evidence.map(([name, detail, context], index) => (
                <button
                  class:list={['evidence-step', { active: index === 0 }]}
                  type="button"
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  data-evidence-step
                  data-evidence-name={name}
                  data-evidence-detail={detail}
                  data-evidence-context={context}
                  data-evidence-index={String(index + 1).padStart(2, '0')}
                >
                  <strong>{name}</strong>
                  <span>{detail}</span>
                </button>
              ))}
            </div>
            <div class="evidence-inspector evidence-inspector--inline" aria-live="polite">
              <span data-evidence-output-index>01</span>
              <strong data-evidence-output-name>Dataset</strong>
              <p data-evidence-output-context>{evidence[0][2]}</p>
            </div>
          </>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <div class="section-register">
            <>
              <div>
                <h2 class="section-title tight">{t('Evaluation that survives scrutiny.', '经得起审查的评测。')}</h2>
              </div>
              <p>{t('Transparent · reproducible · extensible', '透明 · 可复现 · 可扩展')}</p>
            </>
          </div>
          <div class="card-grid">
            <>
              <article class="card">
                <>
                  <ClaimBadge status="today" locale={locale} />
                  <h3>{t('Versioned semantics', '语义版本化')}</h3>
                  <p>
                    {t(
                      'Benchmark metadata publishes evaluation versions, so prompt, mapping, data or scoring changes can be visible.',
                      'Benchmark metadata 发布评测版本，使 prompt、映射、数据或评分变化可见。'
                    )}
                  </p>
                </>
              </article>
