        </div>
      </section>
      <section class="section">
        <div class="container">
          <BenchmarkCatalog locale={locale} />
        </div>
      </section>
      <section class="section">
        <div class="container two-col">
          <>
            <article class="panel">
              <>
                <h3>{t('Metadata is evidence', 'Metadata 即证据')}</h3>
                <p>
                  {t(
                    'Each catalog entry routes to generated documentation and carries task type, modality and metrics. Missing metadata causes the site check to fail.',
                    '每条目录项链接到生成的文档，包含任务类型、模态和指标。缺少 metadata 文件会使网站检查失败。'
                  )}
                </p>
              </>
            </article>
            <article class="panel">
              <>
                <h3>{t('Contribute without ceremony', '简洁地参与贡献')}</h3>
