---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../types';
interface Props {
  title: string;
  prompt: string;
  locale?: Locale;
}
const { title, prompt, locale = 'en' } = Astro.props;
const copyLabel = locale === 'zh' ? '复制提示词' : 'Copy prompt';
const copiedLabel = locale === 'zh' ? '已复制' : 'Copied';
---

<article class="panel prompt-card">
  <h3>{title}</h3><pre>{prompt}</pre><button
    class="button alt"
    type="button"
    data-copy={prompt}
    data-copy-label={copyLabel}
    data-copied-label={copiedLabel}><Icon name="tabler:copy" /><span>{copyLabel}</span></button
  >
</article>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      const label = button.querySelector('span');
      if (!label) return;
      label.textContent = button.dataset.copiedLabel ?? 'Copied';
      window.setTimeout(() => {
        label.textContent = button.dataset.copyLabel ?? 'Copy prompt';
      }, 1400);
    });
  });
</script>
<style>
  .prompt-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .prompt-card h3 {
    margin: 0;
  }
  pre {
    flex: 1;
    margin: 0;
    white-space: pre-wrap;
    color: var(--muted);
    font: 12px/1.55 var(--mono);
  }
  .prompt-card .button {
    align-self: flex-start;
  }
  .prompt-card .button.alt {
    border-color: var(--ink);
    background: transparent;
    color: var(--ink);
  }
  .prompt-card .button.alt:hover {
    border-color: var(--blue);
    background: var(--blue);
    color: #fff;
  }
</style>
