  {
    "id": "percent-ratio-basic",
    "description": "Bounded ratio rendered as percent: multiplier 100, one decimal, no space before %.",
    "semantics": {
      "semantic_id": "quality.accuracy.ratio",
      "metric_name": "Accuracy",
      "role": "primary",
      "direction": "higher_is_better",
      "raw_unit": null,
      "value_range": {
        "min": 0.0,
        "max": 1.0
      },
      "display_kind": "percent",
      "display_multiplier": 100.0,
      "display_unit": "%",
      "display_precision": 1,
      "contract_version": 1
    },
    "value": 0.8567,
    "expected_primary": "85.7%",
    "expected_raw": "0.8567"
  },
